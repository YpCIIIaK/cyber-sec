{
  "name": "cyberpath",
  "version": "1.0.0",
  "description": "CyberPath — бесплатная интерактивная платформа по кибербезопасности (чистые HTML/CSS/JS, без бэкенда)",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "node tests/validate.cjs && node tests/autotest.cjs",
    "validate": "node tests/validate.cjs",
    "autotest": "node tests/autotest.cjs",
    "check:why": "node tests/why-diff.cjs && node tests/missing-why.cjs",
    "dump": "node tests/dump.cjs",
    "inspect": "node tests/inspect.cjs",
    "sandbox": "node tests/sandbox-check.cjs",
    "serve": "python -m http.server 8000"
  },
  "engines": { "node": ">=18" }
}